# Frontend Environment Variables
# Copy this file to .env and fill in the values

# Supabase (pre-configured for Bolt projects)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend API URL (for the Python FastAPI backend)
# This is used if you deploy the FastAPI backend separately
VITE_API_URL=http://localhost:8000

# Contact form email configuration (used by the contact edge function)
# The admin email address that receives contact form submissions
SHERE_ADMIN_EMAIL=hello@sheremoments.com

# SMTP configuration for sending emails (Resend, Mailgun, or any SMTP service)
# Option 1: Resend API (recommended)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=hello@sheremoments.com

# Option 2: Generic SMTP
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM_EMAIL=hello@sheremoments.com
